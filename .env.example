# SolarEdge Harvest (seh) configuration - copy to .env and edit, then: chmod 600 .env
# seh 0.3.0+ uses the SolarEdge Monitoring API V2 (OAuth). Upgrading from 0.2.x (API key)?
# See docs/MIGRATING_TO_API_V2.md. All settings use the SEH_ prefix; environment variables
# override values in this file. Use another file with: seh -c /path/to/file.env <command>

# =============================================================================
# Required: SolarEdge API V2
# =============================================================================
# Create a free app with Site Access at https://developer.solaredge.com/ and register the
# redirect URI http://127.0.0.1:8765/callback. Then run: seh auth login
SEH_OAUTH_CLIENT_ID=your_client_id
SEH_OAUTH_CLIENT_SECRET=your_client_secret

# Site ID(s) to sync, comma-separated (V2 cannot list sites; find the ID in the
# monitoring portal URL: https://monitoring.solaredge.com/.../site/1234567/...)
SEH_SITE_IDS=1234567

# =============================================================================
# Sign-in state and API budget (defaults shown)
# =============================================================================
# OAuth tokens (written with owner-only permissions; use each sign-in on one machine only)
# SEH_TOKEN_FILE=~/.config/seh/tokens.json
# Loopback port of the registered redirect URI
# SEH_OAUTH_REDIRECT_PORT=8765
# Monthly API credit ledger shared by all seh processes on this machine
# SEH_USAGE_FILE=~/.config/seh/usage.json
# Free tier: 2000 credits per calendar month (1 per request), 10 requests per minute.
# A daily incremental sync uses about 8-10 credits.
# SEH_API_MONTHLY_CREDITS=2000
# SEH_API_PER_MINUTE_LIMIT=10
# SEH_API_MAX_CONCURRENT=3
# SEH_API_TIMEOUT=10
# SEH_API_BASE_URL=https://monitoringapi.solaredge.com/v2

# =============================================================================
# Database
# =============================================================================
# SQLite (default)
SEH_DATABASE_URL=sqlite:///./seh.db
# PostgreSQL (uv sync --extra postgresql)
# SEH_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/seh
# MariaDB/MySQL (uv sync --extra mariadb)
# SEH_DATABASE_URL=mariadb+mariadbconnector://user:password@localhost:3306/seh

# =============================================================================
# Sync
# =============================================================================
# Data types to skip, comma-separated. `seh check-api --update-config` fills this in.
# Valid: site, equipment, energy, power, power_details, storage, meter, environmental,
#        alert, inventory, inverter_telemetry, optimizer_telemetry
# (optimizer_telemetry is not available in API V2 and is always skipped)
# SEH_SKIP_DATA_TYPES=meter,alert

# Lookback on the first sync or with --full (days)
# SEH_ENERGY_LOOKBACK_DAYS=365
# SEH_POWER_LOOKBACK_DAYS=7
# SEH_POWER_DETAILS_LOOKBACK_DAYS=25
# Overlap for incremental syncs (minutes)
# SEH_SYNC_OVERLAP_MINUTES=15
# Power resolution: QUARTER_HOUR, HOUR, DAY, WEEK, MONTH, YEAR
# SEH_POWER_TIME_UNIT=QUARTER_HOUR

# =============================================================================
# Error handling
# =============================================================================
# strict (stop on first error), lenient (log and continue), skip (silent)
# SEH_ERROR_HANDLING=lenient
# SEH_MAX_RETRIES=3
# SEH_RETRY_DELAY=2.0

# =============================================================================
# Logging
# =============================================================================
# SEH_LOG_LEVEL=INFO
# SEH_LOG_FILE=./logs/seh.log
# SEH_LOG_MAX_BYTES=10485760
# SEH_LOG_BACKUP_COUNT=5

# =============================================================================
# Email notifications
# =============================================================================
# SEH_SMTP_ENABLED=false
# SEH_SMTP_HOST=smtp.gmail.com
# SEH_SMTP_PORT=587
# SEH_SMTP_USE_TLS=true
# SEH_SMTP_USERNAME=user@example.com
# SEH_SMTP_PASSWORD=app-password
# SEH_SMTP_FROM_EMAIL=alerts@example.com
# SEH_SMTP_TO_EMAILS=admin@example.com
# SEH_NOTIFY_ON_ERROR=true
# SEH_NOTIFY_ON_SUCCESS=false
